# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db). Optional if RSVPs go to Google Sheets.

# ── RSVP Google Sheet ──────────────────────────────────────────
# Use ONE of these two connections. Acceptances and declines are appended
# to a tab named RSVPs: Submitted at, Name, Contact, Attending, Guests, Note.

# Option A — Apps Script web app (see scripts/google-sheets-rsvp.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Option B — Google Cloud service account. Share the sheet with the
# service account email as Editor. Keep the private key on one line with \n.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=RSVPs
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
