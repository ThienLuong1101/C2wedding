# ── Backend (optional) ─────────────────────────────────────────
APP_ID=wedding
APP_SECRET=change-me

# ── Database (optional if RSVPs go to Google Sheets) ───────────
DATABASE_URL=

# ── RSVP Google Sheet (required for RSVP on Railway) ───────────
# Option A — Apps Script web app (see scripts/google-sheets-rsvp.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Option B — Google Cloud service account (optional alternative)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=RSVPs
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
